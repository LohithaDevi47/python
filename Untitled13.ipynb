   "source": [
    "def number_pattern(n):\n",
    "    if not isinstance(n, int):\n",
    "        return \"Argument must be an integer value.\"\n",
    "    \n",
    "    if n <= 0:\n",
    "        return \"Argument must be an integer greater than 0.\"\n",
    "    \n",
    "    return \" \".join(str(i) for i in range(1, n + 1))"
   ]
